#!/bin/sh
#
# @name MDL Gazebo platform EKF (GPS telemetry only, no QGC/RC required)
#
# @type Quadrotor
#
# This airframe is used for the second PX4 instance that attaches to the
# `platform_ekf` model in baylands.sdf. Its sole purpose is to publish GPS
# telemetry for the moving platform — it never flies. We disable QGC/RC
# failsafes so the instance runs headlessly alongside the main drone, and
# disable DDS time sync so ROS 2 receives pure Gazebo sim time.
#
# Launch command (second terminal, after main drone is up):
#   PX4_GZ_STANDALONE=1 PX4_SYS_AUTOSTART=4023 PX4_GZ_MODEL_NAME=platform_ekf \
#     ./build/px4_sitl_default/bin/px4 -i 2
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Disable DDS Time Synchronization so ROS 2 gets pure Gazebo Sim Time
# param set-default UXRCE_DDS_SYNCT 0

# Disable the requirement for a Ground Control Station (QGC) heartbeat
param set-default NAV_DLL_ACT 0

# Disable the requirement for an RC remote/joystick connection
param set-default NAV_RCL_ACT 0
